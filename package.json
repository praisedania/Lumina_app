{
  "name": "lumina-monorepo",
  "version": "1.0.0",
  "description": "Lumina Learning Management System Monorepo",
  "private": true,
  "scripts": {
    "dev": "npm --prefix lumina-backend run dev",
    "dev:backend": "npm --prefix lumina-backend run dev",
    "dev:frontend": "npm --prefix lumina-frontend run dev",
    "start:backend": "npm --prefix lumina-backend start",
    "start:frontend": "npm --prefix lumina-frontend start",
    "build:frontend": "npm --prefix lumina-frontend run build",
    "install:backend": "npm --prefix lumina-backend install",
    "install:frontend": "npm --prefix lumina-frontend install",
    "install:all": "npm --prefix lumina-backend install && npm --prefix lumina-frontend install"
  }
}
