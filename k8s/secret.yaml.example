apiVersion: v1
kind: Secret
metadata:
  name: lumina-backend-secret
  namespace: lumina
  labels:
    app.kubernetes.io/name: lumina-backend
    app.kubernetes.io/part-of: lumina-lms
type: Opaque
# NOTE: Copy this file to secret.yaml and replace placeholders with your actual secrets.
# Never commit secret.yaml containing actual credentials to Git.
stringData:
  DB_USER: "postgres"
  DB_PASSWORD: "your_db_password"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "your_postgres_password"
  POSTGRES_DB: "lumina_db"
  JWT_SECRET: "your_super_secret_jwt_key_here"
  RESEND_API_KEY: "re_your_resend_api_key_here"
  RESEND_FROM_EMAIL: "noreply@yourdomain.com"
  PAYSTACK_SECRET_KEY: "sk_test_your_paystack_secret_key"
